<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SCROLL VIEW"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ScrollView allows the user to scroll vertically when the content is larger than the screen."
            android:textSize="18sp"
            android:padding="15dp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 1" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 2" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 3" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 4" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 5" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 6" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 7" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 8" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 9" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Item 10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End of ScrollView"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="30dp" />

    </LinearLayout>

</ScrollView>